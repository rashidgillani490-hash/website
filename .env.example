# ---------------------------------------------------------------------------
# Maison Lumière — environment configuration
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# Public site URL (used for absolute URLs / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
#
# The URL and anon key are PUBLIC (safe in the browser) — access is gated by
# Row Level Security. The service-role key is SECRET: it bypasses RLS and must
# only ever be read server-side. Never prefix it with NEXT_PUBLIC_.
#
# When these are blank the app runs against bundled demo content.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co   (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service-role key — SECRET, server-only (seeding, admin mutations, webhooks)
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string — used by `npm run db:test` / `db:seed`
# only if you prefer raw SQL access. Optional.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Admin Dashboard
#
# ADMIN_DEV_BYPASS lets you open /admin without signing in — DEV ONLY. It is
# ignored in production (NODE_ENV=production) and whenever Supabase is
# configured (real Supabase Auth + `profiles.role` must be used instead).
# ---------------------------------------------------------------------------
ADMIN_DEV_BYPASS=false

# ---------------------------------------------------------------------------
# Local-mode customer sessions
#
# Only used when Supabase is NOT configured — signs the customer login
# cookie (see src/lib/customer/session-token.ts). Required in production if
# you run without Supabase (not recommended: see README "Deployment"); the
# app refuses to start signing sessions in production without it. Generate a
# strong random value, e.g.: `openssl rand -base64 32`
# ---------------------------------------------------------------------------
LOCAL_AUTH_SECRET=
